# ============================================================================
# Upac Library — variables d'environnement
# Copier ce fichier vers `.env` et renseigner les valeurs réelles.
# `.env` est ignoré par git : ne jamais committer de secrets.
#
# Cible de production : Cloudflare Workers + OpenNext (docs/adr/0001).
# - Les variables NEXT_PUBLIC_* sont figées au BUILD : les définir avant
#   `opennextjs-cloudflare build` (CI ou poste de déploiement).
# - Les secrets serveur sont à créer avec `wrangler secret put <NOM>`.
#   Ce fichier sert de référence, pas de source de vérité en production.
# ============================================================================

# ----------------------------------------------------------------------------
# Base de données (PostgreSQL Supabase)
# ----------------------------------------------------------------------------
# Connexion du pooler (runtime Prisma). Remplacer <user>/<password>/<ref>.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Connexion directe (migrations Prisma). Facultative selon l'hébergement.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Nombre max de connexions du pool Prisma par isolate/instance (défaut : 2).
# Sur Cloudflare Workers, garder 1–2 pour ne pas saturer le pooler Supabase.
DATABASE_POOL_MAX=2

# ----------------------------------------------------------------------------
# Supabase (client + serveur)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<clé publiable anon>"
# Jamais exposée au client : réservée au serveur (Admin API, RPC cron…).
SUPABASE_SERVICE_ROLE_KEY="<clé service_role>"

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
# URL publique du site. Obligatoirement en https en production.
NEXT_PUBLIC_SITE_URL="https://bibliotheque.upac.example"
# Autorise exceptionnellement http:// (tests `next start` en local uniquement).
ALLOW_INSECURE_SITE_URL="false"

# Mot de passe initial du compte étudiant de démonstration (seed). Doit être
# robuste et changé à la 1re connexion. Ne jamais réutiliser en production.
DEFAULT_STUDENT_PASSWORD="<mot de passe robuste>"

# Compte SUPERADMIN bootstrap : requis par les scripts de vérification
# (smoke / RLS). Générer une valeur aléatoire longue, ne pas committer.
SUPERADMIN_PASSWORD="<mot de passe aléatoire>"

# Créer le compte étudiant de démonstration lors du seed (false en production).
SEED_DEMO_STUDENT="true"

# Nombre de mois d'inactivité avant passivation automatique d'un étudiant.
INACTIVITY_MONTHS=6

# Bucket Supabase Storage privé contenant les documents.
DOCUMENT_STORAGE_BUCKET="university-documents"

# Taille maximale d'un fichier importé (Mo).
MAX_UPLOAD_SIZE_MB=50

# ----------------------------------------------------------------------------
# Exploitation / sécurité
# ----------------------------------------------------------------------------
# Rate-limit PARTAGÉ (recommandé en production).
# Absent = limiteur en mémoire par isolate, insuffisant pour un quota global.
# `ioredis` convient à un déploiement Node ; sur Workers, préférer un Redis
# HTTP (Upstash REST) ou un Durable Object (docs/adr/0003).
# Exemple : redis://default:<password>@<host>:6379
REDIS_URL=""

# Secret protégeant /api/cron/*. Sans lui, ces routes répondent 503 (fail-closed).
# Générer avec : openssl rand -hex 32
CRON_SECRET=""

# Endpoint optionnel recevant les erreurs serveur (JSON) : Sentry, Slack,
# webhook maison… Absent = journalisation locale uniquement.
ERROR_WEBHOOK_URL=""

# Niveau de log : debug | info | warn | error (défaut : info en production).
LOG_LEVEL="info"

# ----------------------------------------------------------------------------
# Planification de la passivation (exemples)
# ----------------------------------------------------------------------------
# pg_cron Supabase (déjà planifié par migration si l'extension est active) OU
# un cron système appelant la route protégée :
#   0 2 * * *  curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#              https://bibliotheque.upac.example/api/cron/deactivate-inactive-students
